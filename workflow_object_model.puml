@startuml workflow_object_model
title Spectracs — SpectralWorkflow object model\nas-built + persistence Option A (concept §9 / §9.5), rev 2026-07-25

hide circle
hide empty methods
skinparam linetype ortho
skinparam classFontSize 12
skinparam class {
  BackgroundColor White
  BorderColor #333333
  BackgroundColor<<persisted>> #CDE7CE
  BorderColor<<persisted>> #2E7D32
  BackgroundColor<<server>> #EEF0FB
  BorderColor<<server>> #4C5FAF
  BackgroundColor<<sdk>> #FFE6CC
  BorderColor<<sdk>> #B36A00
  BackgroundColor<<enum>> #FFF7E6
  BorderColor<<enum>> #B58900
  BackgroundColor<<postponed>> #F2F2F2
  BorderColor<<postponed>> #999999
  BackgroundColor<<view>> #EAF2FB
  BorderColor<<view>> #3A6EA5
}

' ===================== config — who runs what (SERVER DB) =====================
class AppUser <<server>> {
  + username (unique)
  + roles : [AppUserRole]
  + pluginId -> DbPlugin (FK, same server DB)
  + spectrometerDevice  (device code-name, e.g. "Virtuax")
}
class DbPlugin <<server>> {
  + title / codeRef / version
  --
  imported by codeRef after login; signature-verify = deferred (§11)
}
class SpectrometerProfile <<persisted>> {
  + serial
  + device + calibration
}
AppUser --> DbPlugin : plugin (FK)
AppUser ..> SpectrometerProfile : device (soft, by code-name)

' ===================== the run = the persisted record (APP DB, Option A) =====================
class SpectralWorkflow <<persisted>> {
  + username / userId      (soft ref -> AppUser, stamped at Save)
  + pluginCodeRef          (soft ref -> DbPlugin.codeRef)
  + timestampIso           (sort key)
  + phases : PhaseType -> Phase  (static spine of 5)
  + metadataFields : [SpectralWorkflowMetadata]   (NOT "metadata" — reserved)
  + currentPhase           : transient
}
SpectralWorkflow ..> AppUser : username / userId (soft, cross-DB)

class SpectralWorkflowMetadata <<persisted>> {
  + name / label / type / value   (type: TEXT | NUMBER | DATE)
  + showInWorkflowsTable   (true -> a Home-list column)
  --
  generic (EAV) rows; self-describing so view/edit needs no plugin
  pumpkin: title (TEXT, home column), temperature (NUMBER °C), dateOfRoasting (DATE)
}
SpectralWorkflow "1" o-- "0..*" SpectralWorkflowMetadata : metadataFields (cascade)

enum SpectralWorkflowPhaseType <<enum>> {
  ACQUISITION
  PROCESSING
  EVALUATION
  METADATA
  PUBLISHING
}

class SpectralWorkflowPhase <<persisted>> {
  + type : PhaseType
  + steps : [Step]  (plugin-created; empty = skipped)
}
SpectralWorkflow "1" o-- "5" SpectralWorkflowPhase : phases
SpectralWorkflowPhase --> SpectralWorkflowPhaseType : type

class SpectralWorkflowStep <<persisted>> {
  .. durable ..
  + role / label / frames / mandatory
  + container : SpectraContainer?
  + evaluationResult : EvaluationResult?
  + persist : bool
  .. transient (host-built, not saved) ..
  + view : ViewSpec?
  + widget : QWidget?
}
SpectralWorkflowPhase "1" o-- "0..*" SpectralWorkflowStep : steps

' ===================== spectral data =====================
class SpectraContainer <<persisted>> {
  + spectra : role -> [Spectrum]  (named bags)
  + inputs : [SpectraContainer]  (operands; persist later)
  + producedBy : Step
}
class Spectrum <<persisted>> {
  + valuesByNanometers : nm -> float
  --
  persists as valuesJson (JSON column) via Spectrum.toJson()/fromJson()
  captured ~N-frame burst = transient (NOT saved)
  + sampleType : SpectrumSampleType
}
enum SpectrumSampleType <<enum>> {
  REFERENCE
  SAMPLE
  DARK
  BLANK
}
SpectralWorkflowStep --> SpectraContainer : container
SpectraContainer "1" o-- "0..*" Spectrum : spectra
SpectraContainer --> "0..*" SpectraContainer : inputs
SpectraContainer --> SpectralWorkflowStep : producedBy
Spectrum --> SpectrumSampleType : sampleType

' ===================== evaluation result = a bag of view-models =====================
class EvaluationResult <<persisted>> {
  + items : [ResultView]
  --
  persists as resultJson (JSON column) via EvaluationResult.toJson()/fromJson()
}
class ResultView <<view>>
class ColorSwatchView <<view>> {
  + rgb
  + label
}
class LabelView <<view>> {
  + text
}
class VerdictView <<view>> {
  + roastState  (PERFECT / UNDER / OVER-ROASTED)
  + hueDegrees
}
class SpectrumPlotView <<view>> {
  + spectrum
  + title
}
class MetricFieldView <<view>> {
  + label
  + value      (unused when color set)
  + tooltip / style
  + color?     (r,g,b) -> value cell renders a swatch, not a field
}
class SpectrumCaptureView <<view>> {
  + caption
  + cropped / roiOverlay   (host fills .image after capture:
     crop-to-ROI / full-frame ROI-border / full-frame mask)
}
class VerdictGaugeView <<view>> {
  + value / thresholds / classes
  + render  (BAND|SWATCH|LABEL|ZONES|VALUE)   -- Roast Ampel gauge
}
class TabGroupView <<view>> {
  + tabs : [(label, ResultView)]
  --
  explicit SUB-TAB container (§7b): Qt -> QTabWidget,
  matplotlib -> children stacked; children recurse
  through ViewModelFactory (nested, host-fill descends)
}
SpectralWorkflowStep --> EvaluationResult : evaluationResult
EvaluationResult "1" o-- "0..*" ResultView : items
ResultView <|-- ColorSwatchView
ResultView <|-- LabelView
ResultView <|-- VerdictView
ResultView <|-- SpectrumPlotView
ResultView <|-- MetricFieldView
ResultView <|-- SpectrumCaptureView
ResultView <|-- VerdictGaugeView
ResultView <|-- TabGroupView
TabGroupView "1" o-- "0..*" ResultView : tabs (children)

' ===================== publishing artifacts (deferred) =====================
class Pdf <<postponed>> {
  + filePath
}
class Email <<postponed>> {
  + recipient / subject / sentAt / status
}
SpectralWorkflowStep ..> Pdf : document (later)
SpectralWorkflowStep ..> Email : email (later)

' ===================== the plugin (SDK class) + ops =====================
class SpectralPlugin <<sdk>> {
  + acquisition(workflow)
  + processing(workflow)
  + evaluation(workflow)
  + metadata(workflow)
  + publishing(workflow)
  --
  Qt-free; imports only plugin_sdk; criteria live in this code
}
class Operation <<sdk>> {
  + apply(SpectraContainer) : SpectraContainer
}
note bottom of Operation
  plugin_sdk ops (as-built): MeanOp, TransmissionOp,
  AbsorptionOp, VerdictOp (+ EvaluationColorUtil)
end note
class MetadataField <<sdk>> {
  + name / label / type / showInWorkflowsTable / order
  --
  metadata() returns [MetadataField]; the wizard builds
  the editable METADATA form from these (and, on reopen,
  from the persisted self-describing rows)
}
DbPlugin ..> SpectralPlugin : loads (by codeRef)
SpectralPlugin ..> SpectralWorkflow : fills (creates steps)
SpectralPlugin ..> Operation : composes
SpectralPlugin ..> MetadataField : declares (metadata hook)
MetadataField ..> SpectralWorkflowMetadata : persisted as

legend right
  <b><<persisted>></b> saved (APP DB) — the workflow IS the record (Option A)
  <b><<server>></b>    SERVER DB (auth + plugin binding); cross-DB refs are soft (dashed)
  <b><<sdk>></b>       plugin-facing, Qt-free
  <b><<view>></b>      renderable result model (host -> QWidget)
  leaf maps persist as JSON columns: Spectrum.valuesJson, EvaluationResult.resultJson
  <b><<postponed>></b> deferred (PDF/email publishing)
endlegend

@enduml
