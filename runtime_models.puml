@startuml runtime_models
title Spectracs — Runtime (non-persisted) model objects (spectracsPy-model)

hide circle
hide empty methods
skinparam linetype ortho
skinparam classFontSize 12
skinparam class {
  BackgroundColor White
  BorderColor #333333
  BackgroundColor<<signal>> #EAF2FB
  BorderColor<<signal>> #3A6EA5
  BackgroundColor<<enum>> #FFF7E6
  BorderColor<<enum>> #B58900
  BackgroundColor<<unwired>> #F2F2F2
  BorderColor<<unwired>> #999999
}

' ===================== LIVE: the measurement at runtime =====================
class SpectralJob <<live>> {
  + title : str
  + spectraBySampleTypes : Dict[SpectrumSampleType, List[Spectrum]]
  --
  transient QObject — discarded on navigate-away (NOT persisted)
}

class Spectrum <<live>> {
  + valuesByNanometers : Dict[int, float]
  + capturedValuesByNanometers : List[Dict[int, float]]
  + colorsByPixelIndices : Dict[int, QColor]
  + sampleType : SpectrumSampleType
}

enum SpectrumSampleType <<enum>> {
  REFERENCE
  SAMPLE
  DARK
  BLANK
  UNSPECIFIED
}

' ===================== LIVE: signals (Qt cross-thread payloads) =====================
class VideoSignal <<signal>> {
  + image : QImage
  + currentFrameIndex : int
  + framesCount : int
}

class SpectralVideoThreadSignal <<signal>> {
  + spectralJob : SpectralJob
}

class SpectrometerCalibrationProfileWavelengthCalibrationVideoSignal <<signal>> {
}

class SpectrometerCalibrationProfileHoughLinesVideoSignal <<signal>> {
  + upperHoughLine / centerHoughLine : QLine
  + calibrationStepUpper/CenterHoughLine : QLine
  + leftBoundingLine / rightBoundingLine : QLine
}

class DbEntityChangedSignal <<signal>> {
  + entity : E
  + operation : DbEntityCrudOperation
}

class SpectrometerProfileSignal <<signal>> {
  (E = SpectrometerProfile)
}

class NavigationSignal <<signal>> {
  + target : str
}

class ApplicationStatusSignal <<signal>> {
  + stepsCount : int
  + currentStepIndex : int
  + text : str
  + isStatusReset : bool
}

' ===================== LIVE: settings =====================
class VirtualSpectrometerSettings <<live>> {
  + virtualCameraImage : QImage
  + doSavePhysicallyCapturedImages : bool
  --
  Singleton — holds the "Set picture" image for the virtual device
}

' ===================== UNWIRED: SpectralWorkflow family =====================
class SpectralWorkflow <<unwired>> {
  + currentPhase : SpectralWorkflowPhase
  + phases : Dict[SpectralWorkflowPhaseType, SpectralWorkflowPhase]
}

class SpectralWorkflowPhase <<unwired>> {
  + type : SpectralWorkflowPhaseType
  + workflow : SpectralWorkflow
  + steps : Dict[str, SpectralWorkflowStep]
  + id : str
}

enum SpectralWorkflowPhaseType <<enum>> {
  ACQUIREMENT
  ACQUIREMENT_VIEW
}

class AcquirementSpectralWorkflowPhase <<unwired>> {
}

class AcquireViewSpectralWorkflowPhase <<unwired>> {
}

class SpectralWorkflowStep <<unwired>> {
  + phase : SpectralWorkflowPhase
  + id : str
}

class AcquireViewSpectralWorkflowStep <<unwired>> {
  + getSpectralSampleTypes() : [SAMPLE, REFERENCE]
}

class SpectraContainer <<unwired>> {
  + spectra : Dict[str, Spectrum]
  + spectraContainers : Dict[str, SpectraContainer]
  + sourceSpectraContainer : SpectraContainer
  + workflowStep : SpectralWorkflowStep
  --
  nestable spectra tree (also has a duplicate __init__ bug)
}

' ===================== Relationships — LIVE =====================
SpectralJob "1" o-- "0..*" Spectrum : spectraBySampleTypes
Spectrum --> SpectrumSampleType : sampleType

VideoSignal <|-- SpectralVideoThreadSignal
SpectralVideoThreadSignal <|-- SpectrometerCalibrationProfileWavelengthCalibrationVideoSignal
VideoSignal <|-- SpectrometerCalibrationProfileHoughLinesVideoSignal
SpectralVideoThreadSignal --> SpectralJob : spectralJob
DbEntityChangedSignal <|-- SpectrometerProfileSignal

' ===================== Relationships — UNWIRED =====================
SpectralWorkflow "1" o-- "0..*" SpectralWorkflowPhase : phases
SpectralWorkflow --> SpectralWorkflowPhase : currentPhase
SpectralWorkflowPhase --> SpectralWorkflowPhaseType : type
SpectralWorkflowPhase "1" o-- "0..*" SpectralWorkflowStep : steps
SpectralWorkflowPhase <|-- AcquirementSpectralWorkflowPhase
SpectralWorkflowPhase <|-- AcquireViewSpectralWorkflowPhase
SpectralWorkflowStep <|-- AcquireViewSpectralWorkflowStep
SpectraContainer "1" o-- "0..*" Spectrum : spectra
SpectraContainer "1" o-- "0..*" SpectraContainer : spectraContainers (tree)
SpectraContainer --> SpectraContainer : sourceSpectraContainer
SpectraContainer --> SpectralWorkflowStep : workflowStep

note as N1
  <b>SpectralWorkflow family + SpectraContainer = UNWIRED.</b>
  Nothing in the app instantiates SpectralWorkflow or SpectraContainer;
  the phase/step classes only reference each other. Aspirational
  multi-phase acquisition model, never connected to the capture path
  (parallels the unused MeasurementProfile DB stub).
end note
N1 .. SpectralWorkflow

legend right
  <b><<signal>></b>  = Qt signal payload (live, cross-thread)
  <b><<enum>></b>    = enumeration
  <b><<unwired>></b> = defined but never instantiated by the app
  white = live runtime object
endlegend

@enduml
