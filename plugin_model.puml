@startuml plugin_model
title Spectracs — Two audiences · serial key · plugin model (concept, rev 2026-06-28)

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

actor "Master (you)" as M
actor "End user\n(oil producer)" as E

component "AppUser\nserial = username" as S #FFFACD

package "Config — bound to the AppUser (downloaded on login)" {
  component "SpectrometerProfile\n(device + calibration)" as P #CDE7CE
  component "Plugin\n(signed code; typically one)" as PM #FFE6CC
}

package "SpectralWorkflow — ONE static spine, shared by every scenario\n(persisted: it IS the run record, has a User)" #EAF2FB {
  component "ACQUISITION" as A
  component "PROCESSING" as PR
  component "EVALUATION" as EV
  component "METADATA" as MD
  component "PUBLISHING" as PB
  A -> PR
  PR -> EV
  EV -> MD
  MD -> PB
}

package "Plugin variants — one phase-hook per phase, each CREATES that phase's steps" {
  component "Pumpkin\nevaluation = spectrum → hue → green/brown" as PU #FFF2CC
  component "Olive\nevaluation = LDA classification" as OL #FFF2CC
  component "DevSpectral (master bench)\nREF+SAMPLE → T → A · NO evaluation\ninjected TRANSIENTLY (not serial-bound)" as DV #D9EAD3
}

M --> P  : creates + calibrates
M --> PM : authors + signs + publishes
E --> S  : login / enter serial
S --> P  : binds
S --> PM : binds
PM ..> A  : creates steps
PM ..> PR : creates steps
PM ..> EV : creates steps
PM ..> MD : creates steps (or skips)
PM ..> PB : creates steps
PU --|> PM
OL --|> PM
DV --|> PM
M ..> DV : runs directly in the dev measurement bench

note bottom of PB
  Host owns Next-navigation + persistence; the plugin never persists.
  End user sees ONLY the result (swatch + verdict) / the PDF.
end note

@enduml
