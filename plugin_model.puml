@startuml plugin_model
title Spectracs — Two audiences · serial key · plugin model (concept, 2026-06-28)

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

actor "Master (you)" as M
actor "End user\n(oil producer)" as E

component "SERIAL\n= key  → (future) unique username" as S #FFFACD

package "Resolved from the serial (future: downloaded on login)" {
  component "SpectrometerProfile\n(device + calibration)" as P #CDE7CE
  component "Plugin Module\n(typically one)" as PM #FFE6CC
}

package "SpectralWorkflow — ONE, generic, shared by all scenarios" #EAF2FB {
  component "ACQUISITION\n(entry point)" as A
  component "PROCESSING\n(entry point)" as PR
  component "EVALUATION\n(entry point)" as EV
  component "RENDER → RESULT" as R
  A --> PR
  PR --> EV
  EV --> R
}

package "Plugin Module variants (fill the entry points)" {
  component "Pumpkin\nevaluation = spectrum → hue → green/brown" as PU #FFF2CC
  component "Olive\nevaluation = LDA classification" as OL #FFF2CC
}

M --> P : creates + calibrates
M --> PM : authors + publishes
E --> S : login / enter serial
S --> P : keys
S --> PM : keys
PM ..> A : fills
PM ..> PR : fills
PM ..> EV : fills
PU --|> PM
OL --|> PM

note bottom of R
  The end user sees ONLY this result (e.g. a color swatch + verdict).
  No spectra, no profiles, no calibration.
end note

@enduml
